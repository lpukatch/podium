node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
.env
.env.local
.local/
data/*.db
data/*.db-wal
data/*.db-shm

# An exported config can carry a live Dispatcharr API key in its settings blob.
# Keep import inputs out of the repo entirely.
data/*.json
dist/

# Local editor/agent state, per-machine. The glob catches the atomic-write temp
# files that land next to it.
.claude/settings.local.json*

# Editor swap files. Not tidiness: a swap file sitting beside an edited
# docker-compose.yml carries whatever was in the buffer, credentials included,
# and `git add -A` will happily commit it.
*.swp
*.swo
*~
